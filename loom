			usage
			shift 1
			return 0
		elif printf "%s" "${1}" | grep -q -E -- "^(-V)|(--vers(i(o(n)?)?)?)" 2>/dev/null; then
			version
			shift 1
			return 0
		elif printf "%s" "${1}" | grep -q -E -- "^(-v)|(--verb(o(s(e)?)?)?)" 2>/dev/null; then
			verbose="1"
			shift 1
		elif printf "%s" "${1}" | grep -q -E -- "^(-w)|(--w(o(r(k(-(d(i(r(e(c(t(o(r(y)?)?)?)?)?)?)?)?)?)?)?)?)?)" 2>/dev/null; then
			case "${1}" in
			*=*)
				leader="${1%%=*}="
				work_dir="${1#"${leader}"}"
				;;
			-w | --work-directory)
