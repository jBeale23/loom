				fi
				case "${2}" in
				-*)
					throw "ERROR: If --work-directory is specified, a work directory must be provided."
					;;
				*)
					work_dir="${2}"
					shift 1
					;;
				esac
				;;
			--work-directory*)
				work_dir="${1#--work-directory}"
				;;
			--work-director*)
				work_dir="${1#--work-director}"
				;;
			--work-directo*)
				work_dir="${1#--work-directo}"
				;;
			--work-direct*)
				work_dir="${1#--work-direct}"
				;;
			--work-direc*)
				work_dir="${1#--work-direc}"
				;;
			--work-dire*)
				work_dir="${1#--work-dire}"
				;;
			--work-dir*)
				work_dir="${1#--work-dir}"
				;;
			--work-di*)
				work_dir="${1#--work-di}"
				;;
			--work-d*)
				work_dir="${1#--work-d}"
				;;
			--work-*)
				work_dir="${1#--work-}"
				;;
			--work*)
				work_dir="${1#--work}"
				;;
			--wor*)
				work_dir="${1#--wor}"
				;;
			--wo*)
				work_dir="${1#--wo}"
				;;
			--w*)
				work_dir="${1#--w}"
